# Kopiere diese Datei zu ".env" und trage deine Werte ein.

# Passwort für das Admin-Panel (/admin) – bitte ein langes, eigenes Passwort wählen!
ADMIN_PASSWORD=bitte-aendern

# Zufälliger, langer Schlüssel für die Login-Sitzung.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port des Servers
PORT=3000

# Ordner für Uploads und Daten (auf dem Server auf ein dauerhaftes Volume zeigen lassen)
DATA_DIR=./data

# Maximale Upload-Größe pro Video in MB
MAX_UPLOAD_MB=500

# Auf "production" setzen, sobald die Seite über HTTPS läuft
NODE_ENV=development
